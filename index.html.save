      <div class="item"><div class="ico">☎</div><div><h4>Téléphone</h4><p>+257 XX XX XX XX</p></div></div>
      <div class="item"><div class="ico">✉</div><div><h4>Email</h4><p>contact@couronnedivine.bi</p></div></div>
